{
	"name": "scratchpad",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:single": "vite build --mode single",
		"build:all": "vite build && vite build --mode single",
		"preview": "vite preview",
		"test": "node tests/site.test.cjs && node tests/update.test.cjs && node tests/single.test.cjs"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource/atkinson-hyperlegible": "5.3.0",
		"harper-editor": "file:./vendor/harper-editor",
		"harper.js": "2.13.0",
		"svelte": "5.43.12"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"vite": "^7.1.10",
		"vite-plugin-singlefile": "^2.3.0",
		"playwright": "1.56.0"
	},
	"description": "A plain-text scratchpad with offline spelling and grammar checking, built on the Harper editor."
}
